# ============================================
# WorkSphere - Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---- General ----
NODE_ENV=development
APP_NAME=WorkSphere
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PYTHON_SERVICE_URL=http://localhost:8000

# ---- PostgreSQL ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=worksphere
DATABASE_USER=worksphere_user
DATABASE_PASSWORD=CHANGE_ME_db_password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- JWT / Auth ----
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# ---- Email (Nodemailer / SMTP) ----
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=noreply@worksphere.example.com

# ---- Object Storage (S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=worksphere-uploads
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1

# ---- Stripe (Sandbox) ----
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_ID=price_CHANGE_ME

# ---- Python Analytics Service ----
ANALYTICS_SERVICE_API_KEY=CHANGE_ME_analytics_key
ANALYTICS_DATABASE_URL=postgresql://worksphere_user:CHANGE_ME@localhost:5432/worksphere

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json
