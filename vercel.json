{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "bindings": [
        {
          "type": "service",
          "service": "analytics",
          "format": "url",
          "env": "PYTHON_SERVICE_URL"
        }
      ]
    },
    "analytics": {
      "root": "python-service/",
      "framework": "fastapi",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "backend" }
    },
    {
      "source": "/ready",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api-docs.json",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api-docs(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
